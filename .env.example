# Zonder sleutel draait alles op een lokale hash-embedder plus een extractief
# antwoord: bruikbaar om de pijplijn te testen, niet om mee te studeren.
OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1024

# Leeg = embedded Qdrant in data/qdrant/. QDRANT_API_KEY geldt alleen bij een
# gehoste instantie.
QDRANT_URL=
# QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=study_chunks

# Laat regels weg in plaats van ze leeg te zetten: een lege waarde overschrijft
# de default met een lege string. Zonder DATABASE_URL kiest config.py een
# absoluut pad naar data/app.db, onafhankelijk van je werkmap.
# DATABASE_URL=

# Hoort in apps/web/.env.local — Next leest deze map niet. Zonder waarde valt
# de frontend terug op http://localhost:8000.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Ook in apps/web/.env.local: het bijschrift rechts in de kop, bijvoorbeeld je
# opleiding en naam. Zonder waarde staat er niets.
# NEXT_PUBLIC_APP_SUBTITLE=Data Science · Je Naam

# Canvas, voor de agenda (deadlines, quizzen, nieuw materiaal). Maak in Canvas
# een access token aan (Account → Settings → New access token) en geef hem een
# vervaldatum; de app leest alleen. Zonder deze twee werkt de agenda op eigen
# taken en course.yml.
# CANVAS_BASE_URL=https://canvas.uva.nl
# CANVAS_ACCESS_TOKEN=